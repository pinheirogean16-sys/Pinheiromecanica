+import { describe, it, expect, beforeEach, afterEach } from 'vitest';
+import { isRateLimited, getClientIp } from '../lib/rate-limit';
+
+describe('C3 — getClientIp', () => {
+  let backup: string | undefined;
+  beforeEach(() => {
+    backup = process.env.TRUSTED_PROXY_HOPS;
+    delete process.env.TRUSTED_PROXY_HOPS; // padrão: 1 proxy
+  });
+  afterEach(() => {
+    if (backup === undefined) delete process.env.TRUSTED_PROXY_HOPS;
+    else process.env.TRUSTED_PROXY_HOPS = backup;
+  });
+
+  it('ATAQUE C3: IP forjado no início do X-Forwarded-For é ignorado', () => {
+    // O cliente envia "1.1.1.1"; o proxy acrescenta o IP real ao final.
+    const h = new Headers({ 'x-forwarded-for': '1.1.1.1, 203.0.113.9' });
+    expect(getClientIp(h)).toBe('203.0.113.9');
+  });
+
+  it('cada tentativa com IP forjado diferente cai no mesmo balde (IP real)', () => {
+    const a = getClientIp(new Headers({ 'x-forwarded-for': '10.0.0.1, 203.0.113.9' }));
+    const b = getClientIp(new Headers({ 'x-forwarded-for': '10.0.0.2, 203.0.113.9' }));
+    expect(a).toBe(b);
+  });
+
+  it('respeita TRUSTED_PROXY_HOPS=2', () => {
+    process.env.TRUSTED_PROXY_HOPS = '2';
+    const h = new Headers({ 'x-forwarded-for': '1.1.1.1, 203.0.113.9, 10.0.0.5' });
+    expect(getClientIp(h)).toBe('203.0.113.9');
+  });
+
+  it('TRUSTED_PROXY_HOPS=0 ignora X-Forwarded-For', () => {
+    process.env.TRUSTED_PROXY_HOPS = '0';
+    const h = new Headers({ 'x-forwarded-for': '1.1.1.1', 'x-real-ip': '198.51.100.7' });
+    expect(getClientIp(h)).toBe('198.51.100.7');
+  });
+
+  it('um único valor e sem cabeçalhos', () => {
+    expect(getClientIp(new Headers({ 'x-forwarded-for': '203.0.113.9' }))).toBe('203.0.113.9');
+    expect(getClientIp(new Headers())).toBe('unknown');
+  });
+});
+
+describe('C3 — limitador não é zerado por inundação de chaves', () => {
+  it('chave bloqueada continua bloqueada após estourar o limite de chaves rastreadas', () => {
+    const janela = 60_000;
+
+    // Enche o mapa com chaves distintas (como um atacante variando o e-mail)
+    for (let i = 0; i < 19_990; i++) isRateLimited(`inundacao:${i}`, 5, janela);
+
+    // Vítima recente: 6 tentativas com limite 5 => bloqueada
+    let r = { limited: false, count: 0, reset: 0 };
+    for (let i = 0; i < 6; i++) r = isRateLimited('login:vitima@x.com:203.0.113.9', 5, janela);
+    expect(r.limited).toBe(true);
+
+    // Estoura o limite de chaves: o código antigo apagava TUDO aqui
+    for (let i = 0; i < 100; i++) isRateLimited(`inundacao-extra:${i}`, 5, janela);
+
+    const depois = isRateLimited('login:vitima@x.com:203.0.113.9', 5, janela);
+    expect(depois.limited).toBe(true);
+  });
+});
