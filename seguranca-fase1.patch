@@ -0,0 +1,54 @@
+import { describe, it, expect, beforeEach, afterEach } from 'vitest';
+import { isSuperAdmin } from '../lib/super-admin';
+
+const KEYS = ['SUPER_ADMIN_USER_ID', 'SUPER_ADMIN_EMAIL', 'SUPER_ADMIN_EMPRESA_ID'] as const;
+let backup: Record<string, string | undefined> = {};
+
+beforeEach(() => {
+  backup = {};
+  for (const k of KEYS) {
+    backup[k] = process.env[k];
+    delete process.env[k];
+  }
+});
+afterEach(() => {
+  for (const k of KEYS) {
+    if (backup[k] === undefined) delete process.env[k];
+    else process.env[k] = backup[k];
+  }
+});
+
+describe('C1 — isSuperAdmin', () => {
+  it('por ID: só o usuário com o ID configurado', () => {
+    process.env.SUPER_ADMIN_USER_ID = 'user-dono';
+    expect(isSuperAdmin({ id: 'user-dono', email: 'a@a.com', empresa_id: 'e1' })).toBe(true);
+    expect(isSuperAdmin({ id: 'outro', email: 'a@a.com', empresa_id: 'e1' })).toBe(false);
+  });
+
+  it('ATAQUE C1: mesmo e-mail em outra empresa NÃO vira super admin (modo ID)', () => {
+    process.env.SUPER_ADMIN_USER_ID = 'user-dono';
+    process.env.SUPER_ADMIN_EMAIL = 'dono@oficina.com'; // legado, ignorado quando há ID
+    const invasor = { id: 'user-invasor', email: 'dono@oficina.com', empresa_id: 'empresa-do-invasor' };
+    expect(isSuperAdmin(invasor)).toBe(false);
+  });
+
+  it('ATAQUE C1: modo compatibilidade exige e-mail E empresa', () => {
+    process.env.SUPER_ADMIN_EMAIL = 'dono@oficina.com';
+    process.env.SUPER_ADMIN_EMPRESA_ID = 'empresa-plataforma';
+    expect(isSuperAdmin({ id: 'x', email: 'dono@oficina.com', empresa_id: 'empresa-plataforma' })).toBe(true);
+    expect(isSuperAdmin({ id: 'y', email: 'dono@oficina.com', empresa_id: 'empresa-do-invasor' })).toBe(false);
+  });
+
+  it('fail-closed: só SUPER_ADMIN_EMAIL (configuração antiga) não dá acesso a ninguém', () => {
+    process.env.SUPER_ADMIN_EMAIL = 'dono@oficina.com';
+    expect(isSuperAdmin({ id: 'x', email: 'dono@oficina.com', empresa_id: 'e1' })).toBe(false);
+  });
+
+  it('fail-closed: sem configuração, ninguém; usuário nulo, ninguém', () => {
+    expect(isSuperAdmin({ id: 'x', email: 'a@a.com', empresa_id: 'e1' })).toBe(false);
+    process.env.SUPER_ADMIN_USER_ID = 'user-dono';
+    expect(isSuperAdmin(null)).toBe(false);
+    expect(isSuperAdmin(undefined)).toBe(false);
+    expect(isSuperAdmin({ email: 'a@a.com' })).toBe(false);
+  });
+});
