new file mode 100644
index 0000000..311b682
--- /dev/null
+++ b/lib/safe-url.ts
@@ -0,0 +1,57 @@
+// ============================================================
+// Validação de URLs de mídia (fotos, logo) — sem dependências,
+// usável no servidor (zod) e no cliente (antes de window.open).
+//
+// Motivo (F1): URLs vindas do banco eram aceitas sem checagem de esquema
+// e abertas com window.open(), o que permite `javascript:` (XSS armazenado).
+// ============================================================
+
+const MAX_URL_LENGTH = 2048;
+const DATA_IMAGE_RE = /^data:image\/(?:png|jpe?g|webp|gif);base64,[A-Za-z0-9+/=]+$/i;
+
+function hasControlOrBackslash(v: string): boolean {
+  // eslint-disable-next-line no-control-regex
+  return /[\u0000-\u001F\u007F\\]/.test(v);
+}
+
+function isHttpsUrl(v: string): boolean {
+  if (v.length > MAX_URL_LENGTH) return false;
+  try {
+    const u = new URL(v);
+    return u.protocol === 'https:' && !!u.hostname && !u.username && !u.password;
+  } catch {
+    return false;
+  }
+}
+
+function isSafeRelativePath(v: string, prefix?: string): boolean {
+  if (v.length > MAX_URL_LENGTH) return false;
+  if (!v.startsWith('/') || v.startsWith('//')) return false; // bloqueia //host (protocol-relative)
+  if (v.includes('..')) return false;
+  if (prefix && !v.startsWith(prefix)) return false;
+  return true;
+}
+
+/** Foto: https://..., /uploads/... (gerado pelo sistema) ou data:image raster (png/jpeg/webp/gif). */
+export function isSafePhotoUrl(value: unknown): value is string {
+  if (typeof value !== 'string') return false;
+  const v = value.trim();
+  if (!v || hasControlOrBackslash(v)) return false;
+  if (DATA_IMAGE_RE.test(v)) return true; // svg e html ficam de fora
+  return isHttpsUrl(v) || isSafeRelativePath(v, '/uploads/');
+}
+
+/** Logo: https://... ou caminho relativo do próprio site. */
+export function isSafeLogoUrl(value: unknown): value is string {
+  if (typeof value !== 'string') return false;
+  const v = value.trim();
+  if (!v || hasControlOrBackslash(v)) return false;
+  return isHttpsUrl(v) || isSafeRelativePath(v);
+}
+
+/** Abre uma foto em nova aba somente se a URL for segura. */
+export function openPhotoSafely(value: unknown): boolean {
+  if (typeof window === 'undefined' || !isSafePhotoUrl(value)) return false;
+  window.open(value.trim(), '_blank', 'noopener,noreferrer');
+  return true;
+}
