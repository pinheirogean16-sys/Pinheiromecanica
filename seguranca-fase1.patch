@@ -0,0 +1,62 @@
+import { describe, it, expect } from 'vitest';
+import { isSafePhotoUrl, isSafeLogoUrl } from '../lib/safe-url';
+
+describe('F1 — isSafePhotoUrl', () => {
+  const permitidas = [
+    'https://res.cloudinary.com/demo/image/upload/v1/foto.jpg',
+    '/uploads/checklist/3f2c9a1e-aaaa-bbbb-cccc-1234567890ab.jpg',
+    'data:image/png;base64,iVBORw0KGgo=',
+    'data:image/jpeg;base64,/9j/4AAQSkZJRg==',
+  ];
+  for (const url of permitidas) {
+    it(`aceita ${url.slice(0, 40)}`, () => {
+      expect(isSafePhotoUrl(url)).toBe(true);
+    });
+  }
+
+  const bloqueadas = [
+    'javascript:alert(document.domain)',
+    'JaVaScRiPt:alert(1)',
+    '  javascript:alert(1)',
+    'java\nscript:alert(1)',
+    'vbscript:msgbox(1)',
+    'data:text/html,<script>alert(1)</script>',
+    'data:text/html;base64,PHNjcmlwdD5hbGVydCgxKTwvc2NyaXB0Pg==',
+    'data:image/svg+xml;base64,PHN2ZyBvbmxvYWQ9YWxlcnQoMSk+',
+    'http://exemplo.com/foto.jpg',
+    '//evil.example/x.png',
+    '/etc/passwd',
+    '/uploads/../../etc/passwd',
+    '/outra-pasta/foto.jpg',
+    'https://user:senha@host.com/x.jpg',
+    'file:///etc/passwd',
+    '',
+    '   ',
+    'https://exemplo.com/' + 'a'.repeat(3000),
+    '\\\\servidor\\share\\x.png',
+  ];
+  for (const url of bloqueadas) {
+    it(`bloqueia ${JSON.stringify(url.slice(0, 40))}`, () => {
+      expect(isSafePhotoUrl(url)).toBe(false);
+    });
+  }
+
+  it('bloqueia valores que não são string', () => {
+    expect(isSafePhotoUrl(undefined)).toBe(false);
+    expect(isSafePhotoUrl(null)).toBe(false);
+    expect(isSafePhotoUrl({ url: 'https://x.com/a.jpg' })).toBe(false);
+  });
+});
+
+describe('F1 — isSafeLogoUrl', () => {
+  it('aceita https e caminho relativo do próprio site', () => {
+    expect(isSafeLogoUrl('https://res.cloudinary.com/x/logo.png')).toBe(true);
+    expect(isSafeLogoUrl('/logo.png')).toBe(true);
+  });
+  it('bloqueia esquemas perigosos e URLs protocol-relative', () => {
+    expect(isSafeLogoUrl('javascript:alert(1)')).toBe(false);
+    expect(isSafeLogoUrl('data:image/png;base64,AAAA')).toBe(false);
+    expect(isSafeLogoUrl('//evil.example/logo.png')).toBe(false);
+    expect(isSafeLogoUrl('http://exemplo.com/logo.png')).toBe(false);
+  });
+});
