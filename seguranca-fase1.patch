+// ============================================================
+// getClientIp — IP do cliente atrás de proxy reverso
+//
+// X-Forwarded-For é preenchido pelo cliente e cada proxy ACRESCENTA o IP que
+// viu ao FINAL. Por isso o primeiro valor é forjável; o confiável é o contado
+// a partir do fim, conforme o número de proxies confiáveis à frente do app
+// (TRUSTED_PROXY_HOPS, padrão 1 = o Apache/.htaccess).
+// ============================================================
+export function getClientIp(headers: Headers): string {
+  const hops = Math.max(0, Number.parseInt(process.env.TRUSTED_PROXY_HOPS ?? '1', 10) || 0);
+  const xff = headers.get('x-forwarded-for');
+
+  if (xff && hops > 0) {
+    const parts = xff.split(',').map((p) => p.trim()).filter(Boolean);
+    if (parts.length > 0) {
+      const idx = parts.length - hops;
+      return parts[idx >= 0 ? idx : 0];
+    }
+  }
+
+  return headers.get('x-real-ip')?.trim() || 'unknown';
+}
