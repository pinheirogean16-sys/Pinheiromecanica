+#   SELECT id FROM User WHERE email = '...' AND empresa_id = '...';
+SUPER_ADMIN_USER_ID=
+# (alternativa de compatibilidade: exige os DOIS)
+# SUPER_ADMIN_EMAIL=
+# SUPER_ADMIN_EMPRESA_ID=
+# Quantidade de proxies confiáveis à frente do app (Apache/.htaccess = 1). Define o IP real no rate limit.
+TRUSTED_PROXY_HOPS=1
+# Segredo dos crons — enviado SOMENTE por cabeçalho (Authorization: Bearer ... ou x-cron-secret)
+CRON_SECRET=
+REGISTER_INVITE_TOKEN=
diff --git a/.htaccess b/.htaccess
index 8f0f023..d40e4d1 100644
--- a/.htaccess
+++ b/.htaccess
@@ -1,4 +1,31 @@
 RewriteEngine On
+
+# ------------------------------------------------------------------
+# S1 — Bloqueio de arquivos do projeto.
+# A regra de proxy abaixo só encaminha ao Node o que NÃO existe como arquivo
+# (!-f). Se o docroot for a raiz do projeto, arquivos existentes seriam
+# servidos direto pelo Apache. Estas regras negam o acesso a eles (403).
+# Recomendado também: apontar o docroot para fora da pasta do projeto.
+# ------------------------------------------------------------------
+# dotfiles (.env, .git, .htaccess...), exceto /.well-known
+RewriteRule (^|/)\.(?!well-known(/|$)) - [F,L]
+# extensões de código/segredos/backups/dumps
+RewriteRule \.(env|sql|bak|log|md|map|prisma|tsbuildinfo|lock|ts|tsx|mts|cts)$ - [F,L]
+# arquivos de configuração e resultados na raiz
+RewriteRule ^(package(-lock)?|tsconfig|test-results|metadata|components)\.json$ - [F,L]
+RewriteRule ^(next|vitest|postcss|tailwind|eslint)\.config\.[a-z]+$ - [F,L]
+RewriteRule ^(database\.sql|Dockerfile|README.*)$ - [F,L]
+# scripts soltos na raiz (menos o service worker, se for reativado)
+RewriteCond %{REQUEST_URI} !^/sw\.js$
+RewriteRule ^[^/]+\.(js|mjs|cjs)$ - [F,L]
+# pastas internas
+RewriteRule ^(prisma|tests|node_modules|scripts|docs|\.next/(?!static))(/|$) - [F,L]
+
+# ------------------------------------------------------------------
+# Proxy para o Next.js (comportamento original)
+# O mod_proxy acrescenta o IP do cliente ao FINAL de X-Forwarded-For;
+# por isso TRUSTED_PROXY_HOPS=1 (ver .env.example e lib/rate-limit.ts).
+# ------------------------------------------------------------------
 RewriteCond %{REQUEST_FILENAME} !-f
 RewriteCond %{REQUEST_FILENAME} !-d
 RewriteRule ^(.*)$ http://localhost:3000/$1 [P,L]
