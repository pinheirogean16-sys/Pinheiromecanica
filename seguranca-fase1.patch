@@ -0,0 +1,45 @@
+// ============================================================
+// Identificação do Super Admin (plataforma)
+//
+// ANTES: o acesso era concedido a quem tivesse o e-mail igual a
+// SUPER_ADMIN_EMAIL. Como o e-mail só é único DENTRO de cada empresa,
+// um usuário de qualquer outra empresa podia ter o mesmo e-mail.
+//
+// AGORA (sem dependências — seguro para Edge/middleware):
+//  1) SUPER_ADMIN_USER_ID  → compara o ID do usuário (preferido).
+//  2) SUPER_ADMIN_EMAIL + SUPER_ADMIN_EMPRESA_ID → exige os DOIS
+//     (e-mail e a empresa da plataforma). Compatibilidade.
+//  Qualquer outra configuração → ninguém é super admin (fail-closed).
+// ============================================================
+
+export interface SuperAdminCandidate {
+  id?: string | null;
+  email?: string | null;
+  empresa_id?: string | null;
+}
+
+let warned = false;
+
+export function isSuperAdmin(user: SuperAdminCandidate | null | undefined): boolean {
+  if (!user) return false;
+
+  const superId = process.env.SUPER_ADMIN_USER_ID?.trim();
+  if (superId) {
+    return !!user.id && user.id === superId;
+  }
+
+  const email = process.env.SUPER_ADMIN_EMAIL?.trim();
+  const empresaId = process.env.SUPER_ADMIN_EMPRESA_ID?.trim();
+  if (email && empresaId) {
+    return !!user.email && !!user.empresa_id && user.email === email && user.empresa_id === empresaId;
+  }
+
+  if (!warned) {
+    warned = true;
+    console.error(
+      '[super-admin] Defina SUPER_ADMIN_USER_ID (ou SUPER_ADMIN_EMAIL + SUPER_ADMIN_EMPRESA_ID). ' +
+        'Sem isso, o painel master fica inacessível.'
+    );
+  }
+  return false;
+}
