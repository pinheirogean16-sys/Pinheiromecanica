+import { describe, it, expect, beforeEach, afterEach } from 'vitest';
+import { validarCronSecret } from '../lib/cron-auth';
+
+let backup: string | undefined;
+beforeEach(() => {
+  backup = process.env.CRON_SECRET;
+});
+afterEach(() => {
+  if (backup === undefined) delete process.env.CRON_SECRET;
+  else process.env.CRON_SECRET = backup;
+});
+
+describe('C2/C11 — validarCronSecret', () => {
+  it('sem CRON_SECRET configurado, nunca autoriza', () => {
+    delete process.env.CRON_SECRET;
+    expect(validarCronSecret(new Headers({ authorization: 'Bearer undefined' }))).toBe(false);
+    expect(validarCronSecret(new Headers({ 'x-cron-secret': '' }))).toBe(false);
+  });
+
+  it('aceita Authorization: Bearer e x-cron-secret corretos', () => {
+    process.env.CRON_SECRET = 'segredo-forte-123';
+    expect(validarCronSecret(new Headers({ authorization: 'Bearer segredo-forte-123' }))).toBe(true);
+    expect(validarCronSecret(new Headers({ 'x-cron-secret': 'segredo-forte-123' }))).toBe(true);
+  });
+
+  it('rejeita segredo errado, de tamanho diferente ou ausente', () => {
+    process.env.CRON_SECRET = 'segredo-forte-123';
+    expect(validarCronSecret(new Headers({ authorization: 'Bearer errado' }))).toBe(false);
+    expect(validarCronSecret(new Headers({ authorization: 'Bearer segredo-forte-1234567' }))).toBe(false);
+    expect(validarCronSecret(new Headers({ 'x-cron-secret': 'x' }))).toBe(false);
+    expect(validarCronSecret(new Headers())).toBe(false);
+  });
+});
