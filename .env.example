# DATABASE_URL: URL de conexão com o banco de dados MySQL (ex: Hostinger)
DATABASE_URL="mysql://usuario:senha@host:3306/db_name"

# JWT_SECRET: Chave secreta para assinatura de tokens JWT
JWT_SECRET="sua_chave_secreta_aqui"

# NEXT_PUBLIC_APP_URL: URL da aplicação
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# GEMINI_API_KEY: Necessária para recursos de IA (diagnóstico inteligente)
NEXT_PUBLIC_GEMINI_API_KEY=""
