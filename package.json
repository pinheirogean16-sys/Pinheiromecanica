    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.5.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "eslint": "9.14.0",
    "eslint-config-next": "15.0.3",
    "fast-xml-parser": "5.7.2",
    "framer-motion": "^11.11.17",
    "jose": "^5.9.6",
